# Copy to .env in the repository root; keep real keys out of Git.
LLM_PROVIDER=mistral
# mock never sends requests. Change to live only when ready.
LLM_MODE=mock
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TEMPERATURE=0.1
MISTRAL_MAX_TOKENS=512
MISTRAL_MAX_ATTEMPTS=3
MISTRAL_TIMEOUT_SECONDS=30
# Optional GLM route; select with --provider glm or LLM_PROVIDER=glm.
# The adapter makes one attempt and allows only these two free GLM model IDs.
FREETHEAI_API_KEY=
FREETHEAI_BASE_URL=https://api.freetheai.org/v1
FREETHEAI_GLM_MODEL=fta/zai/glm-5.3
FREETHEAI_GLM_FLASH_MODEL=fta/zai/glm-5.3-flash
# Gemini is deferred: AI Studio redirected to the available-regions page.
# No Google key or successful Gemini/Gemma request was obtained.
# Add and validate a Gemini adapter before setting LLM_PROVIDER=gemini.
